<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Recto.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Recto.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Borderless icon buttons for the title bar and panel headers  -->
            <Style
                x:Key="ToolbarButtonStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  Smaller variant that fits the standard 32px title bar  -->
            <Style
                x:Key="TitleBarButtonStyle"
                BasedOn="{StaticResource ToolbarButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="28" />
            </Style>

            <Style
                x:Key="ToolbarToggleStyle"
                BasedOn="{StaticResource DefaultToggleButtonStyle}"
                TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  Text typed over a page: only the text, so it looks as it will once it's on the page. The frame around it is the view's  -->
            <Style x:Key="AnnotationTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
                <Setter Property="IsTextPredictionEnabled" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}">
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Margin="{TemplateBinding Padding}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    HorizontalScrollBarVisibility="Hidden"
                                    HorizontalScrollMode="Disabled"
                                    IsTabStop="False"
                                    VerticalScrollBarVisibility="Hidden"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="SubtleButtonStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!--
                For elements built in code. Brushes looked up in Application.Current.Resources follow the
                system theme, not the one chosen in Settings; theme resources in a style follow the element.
            -->
            <Style
                x:Key="SecondaryTextBlockStyle"
                BasedOn="{StaticResource BodyTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style
                x:Key="SecondaryCaptionTextBlockStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style
                x:Key="CriticalTextBlockStyle"
                BasedOn="{StaticResource BodyTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style
                x:Key="CriticalCaptionTextBlockStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!--  Settings page rows, sized like the cards in Windows Settings  -->
            <Style TargetType="controls:SettingsCard">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,0,16,0" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:SettingsCard">
                            <Grid
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox
                                    Width="20"
                                    Height="20"
                                    Margin="2,0,20,0"
                                    VerticalAlignment="Center">
                                    <ContentPresenter Content="{TemplateBinding HeaderIcon}" />
                                </Viewbox>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="0,12,16,12"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                        Text="{TemplateBinding Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ContentPresenter
                                    Grid.Column="2"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="KeyCapBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="7,2,7,3" />
            </Style>

            <!--  Small floating surfaces over the document (status pill)  -->
            <Style x:Key="FloatingBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!--  Middle-click autoscroll origin marker  -->
            <Style x:Key="MiddleScrollMarkerStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                <Setter Property="Stroke" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
            </Style>

            <Style x:Key="MiddleScrollGlyphStyle" TargetType="Shape">
                <Setter Property="Fill" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!--  Search boxes: queries aren't prose, so no spell-check squiggles  -->
            <Style
                x:Key="SearchTextBoxStyle"
                BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}"
                TargetType="TextBox">
                <Setter Property="IsSpellCheckEnabled" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
