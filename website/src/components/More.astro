---
import { links } from '../lib/links';
import type { IconName } from '../lib/icons';
import Icon from './Icon.astro';

const items: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'bookOpen',
    title: 'Spreads, in light or dark',
    text: 'Read two pages side by side, odd pages on the left if you like, in a theme that follows Windows.',
  },
  {
    icon: 'weatherMoon',
    title: 'Night mode',
    text: 'Invert page colors for reading late with Ctrl+I, without touching the file.',
  },
  {
    icon: 'presenter',
    title: 'Full screen and presenting',
    text: 'F11 hides everything but the pages, and F5 shows slides one page at a time.',
  },
  {
    icon: 'textBulletListTree',
    title: 'Outline and attachments',
    text: 'Jump through the table of contents, and open or save files embedded in the PDF.',
  },
  {
    icon: 'image',
    title: 'Thumbnails in File Explorer',
    text: 'With the Store version as your PDF app, Explorer shows each file’s first page.',
  },
  {
    icon: 'windowMultiple',
    title: 'A window per document',
    text: 'PDFs opened from Explorer open as new windows of the Recto that’s already running.',
  },
  {
    icon: 'arrowSync',
    title: 'Reloads on change',
    text: 'When a file changes on disk, Recto reloads it. Each document also remembers its page, zoom and view.',
  },
  {
    icon: 'lockClosed',
    title: 'Password-protected PDFs',
    text: 'Encrypted documents open with their password, and reloads don’t ask for it again.',
  },
  {
    icon: 'shieldCheckmark',
    title: 'Careful with links',
    text: 'Only web and mail links open, never JavaScript or launch actions, and link hovers spell out the real host.',
  },
  {
    icon: 'translate',
    title: 'Three languages',
    text: 'English, French and Chinese, following your Windows display language or the one you choose.',
  },
  {
    icon: 'keyboard',
    title: 'Keyboard friendly',
    text: 'Everything has a shortcut. Press F1 to see them all.',
  },
  {
    icon: 'documentOnePageMultiple',
    title: 'Big files, no fuss',
    text: 'Documents up to 8 GB and a million pages, drawn a tile at a time as you zoom in.',
  },
];
---

<section class="section more" aria-labelledby="more-title">
  <div class="container">
    <div class="section-head">
      <h2 class="title" id="more-title">And there’s more</h2>
    </div>
    <ul class="grid">
      {
        items.map((item) => (
          <li class="card tile">
            <span class="tile-icon">
              <Icon name={item.icon} size={20} />
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="all caption">
      See the <a href={links.features}>full feature list and known limitations</a> on GitHub.
    </p>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 12px;
  }

  .tile {
    display: flex;
    gap: 16px;
    padding: 20px;
    transition: background-color 83ms linear;
  }

  .tile:hover {
    background: var(--card-hover);
  }

  .tile-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    color: var(--accent-text);
    background: var(--accent-soft);
  }

  h3 {
    font: 600 15px/1.4 var(--font-text);
  }

  .tile p {
    margin-top: 4px;
    font-size: 14px;
    color: var(--text-2);
  }

  .all {
    margin-top: 28px;
    text-align: center;
  }
</style>
